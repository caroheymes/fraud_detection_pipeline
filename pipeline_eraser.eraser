   // =============================================================
    // ML Pipeline — Fraud Detection
    // Coller ce code dans eraser.io > Diagram as Code
    // =============================================================

    typeface clean
    colorMode bold
    direction right

    // ------- CACHE LAYER -------
    Redis [icon: redis, label: "Redis Cache", textSize: large]

    // ------- BLOCS DE STRUCTURE -------
    Realtime Flow [color: blue, icon: zap] {
      Client [icon: monitor, label: "Client (Site Marchand)", textSize: large]
      Ray Cluster [icon: server, color: orange] {
        FastAPI [icon: fastapi, label: "Ray Serve / FastAPI", textSize: large]
        SHAP Inline [icon: search, label: "SHAP TreeExplainer (inline)", textSize: large]
        XGBoost [icon: brain, label: "Repliques Modele ML (XGBoost)", textSize: large]
      }
    }

    Batch Retraining [color: green, icon: refresh-cw] {
      Airflow [icon: apache-airflow, label: "Airflow Scheduler", textSize: large]
      Retrain Layer [color: green] {
        Evidently [icon: eye, label: "Audit Evidently (Drift)", textSize: large]
        Ray Train [icon: gear, label: "Ray Train + Optuna HPO", textSize: large]
        Shapash Export [icon: file-text, label: "export_rules.py (Shapash)", textSize: large]
      }
      MLflow [icon: mlflow, label: "MLflow Registry", textSize: large]
    }

    Data and Analytics [color: blue, icon: database] {
      Postgres [icon: postgresql, label: "PostgreSQL (Silver + Gold)", textSize: large]
      dbt [icon: dbt, label: "dbt (Silver to Gold)", textSize: large]
      Streamlit [icon: streamlit, label: "Streamlit Dashboard", textSize: large]
    }



    // =============================================================
    // FLUX 1 — TEMPS RÉEL (Transaction → Réponse)
    // =============================================================

    // 1. Transaction HTTP entrante
    Client > FastAPI: 1. Transaction HTTP [textSize: medium]

    // 2. Fast-Path check (lecture des seuils SHAP depuis Redis)
    FastAPI <> Redis: 2. Seuils fast pass [textSize: medium]

    // 3. Inférence XGBoost systématique
    FastAPI > XGBoost: 3. Inference ML [textSize: medium]

    // 4. Calcul SHAP local (inline dans l'API)
    FastAPI > SHAP Inline: 4. Calcul SHAP local [textSize: medium]

    // 5. Log asynchrone dans PostgreSQL
    FastAPI > Postgres: 5. Log async [color: blue, textSize: medium]

    // 6. Réponse au client
    FastAPI > Client: 6. Reponse JSON [textSize: medium]

    // 7. Webhook asynchrone si fraude (enregistré dans Redis & envoyé au marchand)
    FastAPI > Redis: 7. Alerte fraude (webhook) [color: red, textSize: medium]



    // =============================================================
    // FLUX 2 — CHARGEMENT MODÈLE & ANALYTICS
    // =============================================================

    // L'API charge le modèle champion depuis MLflow au startup
    MLflow > XGBoost: Chargement champion (startup / reload-model) [color: purple, textSize: medium]

    // dbt transforme Silver → Gold dans PostgreSQL
    Postgres > dbt: Silver [textSize: small]
    dbt > Postgres: Vues Gold [textSize: small]

    // Streamlit affiche les vues Gold et les alertes Redis
    Postgres > Streamlit: Vues analytiques [color: blue, textSize: medium]
    Redis > Streamlit: Alertes live (webhook) [color: red, textSize: medium]


    // =============================================================
    // FLUX 3 — BATCH QUOTIDIEN (Drift → Retrain → Export Rules)
    // =============================================================

    // Airflow orchestre le DAG drift_and_retrain_loop (tous les jours à 2h)
    Airflow > Evidently: Audit drift quotidien (2h) [textSize: medium]
    Evidently <> Postgres: Drift check (reference_data) [textSize: medium]

    // Si drift détecté → réentraînement
    Evidently > Ray Train: Drift detecte [color: green, textSize: medium]

    // Réentraînement et promotion champion
    Ray Train > MLflow: Nouveau modele champion [color: green, textSize: medium]

    // Export des règles SHAP globales (Shapash) dans les deux cas
    Airflow > Shapash Export: Export regles [textSize: medium]
    Shapash Export > Redis: Update fraud_rules:config [color: orange, textSize: medium]
    Shapash Export > MLflow: Charge modele champion [textSize: medium]

    // =============================================================
    // LÉGENDE
    // =============================================================
    legend {
      [connection: ">", color: blue, label: "Flux donnees"]
      [connection: ">", color: red, label: "Alerte fraude"]
      [connection: ">", color: green, label: "Drift et reentrainement"]
      [connection: ">", color: purple, label: "Chargement modele"]
    }